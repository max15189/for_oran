# Copy this file to .env and fill in your values

# WhatsApp Cloud API endpoint
# Format: https://graph.facebook.com/v19.0/<YOUR_PHONE_NUMBER_ID>/messages
WHATSAPP_API_URL=https://graph.facebook.com/v19.0/YOUR_PHONE_NUMBER_ID/messages

# Permanent access token from Meta developer console
WHATSAPP_TOKEN=YOUR_ACCESS_TOKEN_HERE

# Recipient phone number in international format WITHOUT the leading +
# Example for Israel (+972): 972501234567
RECIPIENT_PHONE=972501234567
