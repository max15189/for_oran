# ── Twilio ─────────────────────────────────────────────────────────────────────
# From twilio.com → Console dashboard
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+12025551234   # the number you bought in Twilio

# Channel: "sms" (default) or "whatsapp"
# For WhatsApp: use the Twilio sandbox number +14155238886 for testing,
# or your approved WhatsApp Sender for production.
MESSAGE_CHANNEL=sms

# ── Admin dashboard ─────────────────────────────────────────────────────────────
# Open http://localhost:5000/admin — use any username, this is the password
ADMIN_PASSWORD=admin123

# ── Invitation text ─────────────────────────────────────────────────────────────
INVITATION_MESSAGE=test 123
