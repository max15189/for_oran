# WhatsApp Cloud API — from Meta developer console
WHATSAPP_API_URL=https://graph.facebook.com/v19.0/YOUR_PHONE_NUMBER_ID/messages
WHATSAPP_TOKEN=YOUR_ACCESS_TOKEN_HERE

# The public URL where this server is reachable (guests will receive this link)
# For local testing use ngrok: https://ngrok.com/
BASE_URL=http://localhost:5000

# Admin dashboard password (visit /admin)
ADMIN_PASSWORD=admin123

# The invitation text sent with the WhatsApp message
INVITATION_MESSAGE=test 123
