# ── WhatsApp Cloud API ─────────────────────────────────────────────────────────
# From Meta developer console → your app → WhatsApp → Getting Started
WHATSAPP_API_URL=https://graph.facebook.com/v19.0/YOUR_PHONE_NUMBER_ID/messages
WHATSAPP_TOKEN=YOUR_ACCESS_TOKEN_HERE

# ── Webhook ────────────────────────────────────────────────────────────────────
# Any secret string you choose — you will paste this into Meta's webhook form
WEBHOOK_VERIFY_TOKEN=my_secret_token_123

# Optional: your App Secret from Meta (adds signature verification on incoming webhooks)
# WHATSAPP_APP_SECRET=

# ── Admin dashboard ────────────────────────────────────────────────────────────
# Visit http://localhost:5000/admin — use any username, this is the password
ADMIN_PASSWORD=admin123

# ── Invitation content ─────────────────────────────────────────────────────────
INVITATION_MESSAGE=test 123
